#!/bin/bash
session_name="scripting"

root_dir="~/sratch/scripts"

editor_window_name="ed"
editor_window_pos=9

dir_window_name="dir"
dir_window_pos=8

doc_window_name="man"
doc_window_pos=7

tmux new -s $session_name -n $editor_window_name -d

tmux move-window -s $session_name:1 -t $editor_window_pos

tmux new-window -n $dir_window_name -t $session_name:$dir_window_pos

tmux new-window -n $doc_window_name -t $session_name:$doc_window_pos
