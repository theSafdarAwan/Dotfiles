#!/bin/bash
session_name="web"

root_dir="$HOME/safdar-local/Learning/The Ultimate HTML5 & CSS3 Series"

editor_window_name="ed"
editor_window_pos=9

dir_window_name="dir"
dir_window_pos=8

doc_window_name="doc"
doc_window_pos=7

tmux new -s "$session_name" -c "$root_dir" -n "$editor_window_name" -d

tmux move-window -s "$session_name:1" -t "$editor_window_pos"

tmux new-window -n "$dir_window_name" -c "$root_dir" -t "$session_name:$dir_window_pos"

tmux new-window -n "$doc_window_name" -c "$root_dir" -t "$session_name:$doc_window_pos"
